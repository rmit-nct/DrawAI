# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# ---------------------------------------------------------------------------
# AI guessing (optional)
# ---------------------------------------------------------------------------
# Without a key the app runs in Mock AI mode and is fully playable; the UI
# labels every mock result clearly. Add a key to enable real Gemini guesses.
# Get one at https://aistudio.google.com/app/apikey
# Server-side only — never exposed to the browser.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Hand tracking assets (optional)
# ---------------------------------------------------------------------------
# By default the MediaPipe runtime and hand model are fetched from public CDNs
# on first use of webcam mode. Set these to serve them from /public instead —
# useful for offline demos or restricted networks. See the README section
# "Self-hosting the hand-tracking model".
NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=
NEXT_PUBLIC_HAND_MODEL_PATH=

# ---------------------------------------------------------------------------
# Database (not used yet)
# ---------------------------------------------------------------------------
# Required once the persistence layer is wired up (user accounts, saved
# drawings, leaderboards). Use MongoDB or PostgreSQL — see README for the
# decision.
DATABASE_URL=
