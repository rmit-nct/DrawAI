# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Required for the real AI guessing endpoint (src/app/api/guess/route.ts).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Required once the database layer is wired up (user accounts, saved
# drawings, leaderboards, etc.). Use one or the other depending on
# which the team picks — see README for the decision.
DATABASE_URL=
